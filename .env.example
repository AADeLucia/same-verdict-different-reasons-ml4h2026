# Copy to .env and fill in. PROJECT_DIR is required: grade_responses.py reads it at
# import time and raises KeyError if unset.
PROJECT_DIR=/absolute/path/to/MEDIC-Completeness

# LLM Judge endpoint (any OpenAI-compatible server: vLLM, OpenAI, Together AI, ...)
MODEL=meta-llama/Llama-3.3-70B-Instruct
SERVER=http://localhost:8000/v1
GRADER_API_KEY=EMPTY

# Decoding and concurrency
DECODING_TEMPERATURE=0
MAX_TOKENS=4096
BATCH_SIZE=8

# Embedding cache for Criteria-Checklist criteria retrieval
CACHE_DIR=./cache

# Only needed for the GPT judges and the RQ2 classifier
OPENAI_API_KEY=
